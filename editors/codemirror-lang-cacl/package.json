{
  "name": "codemirror-lang-cacl",
  "version": "0.1.0",
  "description": "Standalone CodeMirror 6 language support (Lezer syntax highlighting, pure-TS static analysis, quick fixes, and autocompletion) for CFMS Access Control Language (CACL / CEP 2) without requiring a language server.",
  "license": "MIT",
  "author": "Creeper19472 <creeper19472@crpteam.club>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cfms-dev/cacl.git",
    "directory": "editors/codemirror-lang-cacl"
  },
  "keywords": [
    "codemirror",
    "codemirror6",
    "lezer",
    "cacl",
    "cep-2",
    "acl",
    "syntax-highlighting",
    "linter"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src/cacl.grammar",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/build.mjs --generate-only",
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "prepare": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "typecheck": "node scripts/build.mjs --generate-only && tsc --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@lezer/common": "^1.5.6",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.12"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/autocomplete": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/generator": "^1.8.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
