// A launch configuration that launches the extension inside a new window
// Run `pnpm run build` (or `pnpm run watch`) in editors/vscode-cacl before launching.
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			]
		}
	]
}
