{
  "name": "vscode-cacl",
  "displayName": "CFMS Access Control Language (CACL)",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Programming Languages"
